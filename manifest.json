{
  "manifest_version": 3,
  "name": "YouTube CineGlow Pro",
  "short_name": "CineGlow Pro",
  "version": "2.2.0",
  "version_name": "2.2.0 Pro",
  "minimum_chrome_version": "105",
  "description": "Ambient lighting, full audio suite (EQ, bass, vocal), speed control, annotations, cinema tools, ad blocker, and live stats — all built into YouTube.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.googlevideo.com/*",
    "https://returnyoutubedislikeapi.com/*",
    "https://storage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "adblock_rules",
        "enabled": true,
        "path": "rules/adblock.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content/main-world.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["shared/defaults.js", "content/player-manager.js", "content/blackbar.js", "content/content.js", "content/youtube-ads.js", "content/youtube-quality.js", "content/stats-overlay.js", "content/pip-button.js", "content/audio-processor.js", "content/smart-pause.js", "content/screenshot-button.js", "content/record-button.js", "content/speed-button.js", "content/return-dislikes.js", "content/hide-shorts.js", "content/annotations.js", "content/hide-endcards.js"],
      "css": ["content/content.css", "content/stats-overlay.css", "content/annotations.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Aura",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
